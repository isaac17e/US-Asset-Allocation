# Copy to .env (git-ignored) and fill in your own keys. Never commit real values.

# Financial Modeling Prep (https://site.financialmodelingprep.com/) - required by both scripts
FMP_API_KEY=

# FRED (https://fred.stlouisfed.org/docs/api/api_key.html) - required by Corp_FR_Optimization.py (free)
FRED_API_KEY=

# Polygon / Massive (https://massive.com/) - optional: option chains.
# Without it, the ETF pipeline falls back to historical moments.
POLYGON_API_KEY=
